{
  "displayName": "Cuckoo Cue Web search failed",
  "combiner": "OR",
  "enabled": true,
  "documentation": { "content": "A search request failed before returning a result. Check the Web operations dashboard and structured `search.failed` logs.", "mimeType": "text/markdown" },
  "alertStrategy": { "notificationRateLimit": { "period": "300s" }, "autoClose": "1800s" },
  "conditions": [{ "displayName": "Search failed", "conditionMatchedLog": { "filter": "resource.type=\"cloud_run_revision\" AND jsonPayload.event=\"search.failed\"" } }]
}
