{
  "displayName": "Cuckoo Cue Web operations",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Search completions and failures",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "completed",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/cuckoocue_search_completed\" AND resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" } } }
              },
              {
                "legendTemplate": "failed",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/cuckoocue_search_failed\" AND resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" } } }
              }
            ],
            "yAxis": { "label": "events/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "BigQuery read cap events",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "BQ cap",
                "plotType": "STACKED_BAR",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/cuckoocue_bq_read_limit\" AND resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_DELTA" } } }
              }
            ],
            "yAxis": { "label": "events", "scale": "LINEAR" }
          }
        }
      },
      {
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "App Hosting requests",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "{{metric.label.response_code_class}}",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"cuckoocue\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.response_code_class"] } } }
              }
            ],
            "yAxis": { "label": "requests/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "App Hosting instances",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "instances",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"cuckoocue\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MEAN", "crossSeriesReducer": "REDUCE_SUM" } } }
              }
            ],
            "yAxis": { "label": "instances", "scale": "LINEAR" }
          }
        }
      },
      {
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Vertex search model calls",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "model usage",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/cuckoocue_search_model_usage\" AND resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" } } }
              }
            ],
            "yAxis": { "label": "events/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 8,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "BigQuery billed bytes",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "bytes",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"bigquery.googleapis.com/query/scanned_bytes_billed\" AND resource.type=\"bigquery_project\"", "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" } } }
              }
            ],
            "yAxis": { "label": "bytes/5m", "scale": "LINEAR" }
          }
        }
      },
      {
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "App Hosting request latency P95",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "P95 latency",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"cuckoocue\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_PERCENTILE_95" } } }
              }
            ],
            "yAxis": { "label": "milliseconds", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 12,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "CSP report-only violations",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "violations",
                "plotType": "LINE",
                "timeSeriesQuery": { "timeSeriesFilter": { "filter": "metric.type=\"logging.googleapis.com/user/cuckoocue_csp_violation\" AND resource.type=\"cloud_run_revision\"", "aggregation": { "alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE" } } }
              }
            ],
            "yAxis": { "label": "events/s", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
